{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paispl.example/schemas/change-proposal.schema.json",
  "title": "PAISPL UML Change Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "proposal_id",
    "request_id",
    "base_configuration_id",
    "base_architecture_hash",
    "origin_uml",
    "edit_type",
    "rationale",
    "operations",
    "proposer",
    "created_at",
    "status",
    "required_approval_policy"
  ],
  "properties": {
    "version": {"const": "0.4.0"},
    "proposal_id": {"type": "string", "pattern": "^CP-[A-Z0-9]+-[0-9]{3}$"},
    "request_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z]+-[0-9]{3}$"},
    "base_configuration_id": {"type": "string", "pattern": "^GOLD-[A-Z]+-[A-Z]+-[0-9]{3}$"},
    "base_architecture_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "origin_uml": {"$ref": "#/$defs/originUml"},
    "edit_type": {
      "enum": ["addition", "removal", "replacement", "preservation", "dependency", "compound"]
    },
    "rationale": {"type": "string", "minLength": 10},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    },
    "proposer": {"$ref": "#/$defs/actor"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": ["DRAFT", "PENDING_VALIDATION", "VALIDATED", "PENDING_APPROVAL", "APPROVED", "REJECTED", "APPLIED"]
    },
    "required_approval_policy": {"const": "human-explicit-v1"}
  },
  "$defs": {
    "originUml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_path", "element_ids"],
      "properties": {
        "model_id": {"type": "string", "minLength": 3},
        "model_path": {"type": "string", "minLength": 3},
        "element_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "kind", "source_id", "target_id", "source_quote"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^CPO-[0-9]{3}$"},
        "kind": {
          "enum": [
            "include_feature",
            "exclude_feature",
            "replace_feature",
            "preserve_feature",
            "add_dependency",
            "remove_dependency",
            "unresolved_semantic_edit"
          ]
        },
        "source_id": {"type": "string", "minLength": 2},
        "target_id": {"type": "string", "minLength": 2},
        "source_quote": {"type": "string", "minLength": 2}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "type": {"enum": ["human", "test_fixture"]}
      }
    }
  }
}
